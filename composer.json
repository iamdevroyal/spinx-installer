{
    "name": "spinx/installer",
    "description": "The official application installer for the Spinx PHP Framework.",
    "keywords": [
        "spinx",
        "php",
        "framework",
        "installer",
        "cli"
    ],
    "homepage": "https://spinxphp.pages.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "iamdevroyal",
            "email": "devroyal@spinx.dev",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "source": "https://github.com/iamdevroyal/spinx-installer",
        "docs": "https://spinxphp.pages.dev/docs"
    },
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Spinx\\Installer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spinx\\Installer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/spinx"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
